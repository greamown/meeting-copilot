{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["should_suggest", "confidence", "category", "suggestion", "reason", "follow_up_question", "evidence_segment_ids", "state_patch"],
  "properties": {
    "should_suggest": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "category": {"enum": ["answer", "missing_decision", "unresolved_question", "contradiction", "risk", "alternative", "summary", "action_item", "off_topic", "no_material_value"]},
    "suggestion": {"type": "string", "maxLength": 1200},
    "reason": {"type": "string", "maxLength": 2000},
    "follow_up_question": {"type": ["string", "null"], "maxLength": 1000},
    "evidence_segment_ids": {"type": "array", "items": {"type": "string"}},
    "state_patch": {
      "type": "object", "additionalProperties": false,
      "required": ["current_topic", "add_decisions", "add_open_questions", "add_risks", "add_action_items", "add_parking_lot"],
      "properties": {
        "current_topic": {"type": ["string", "null"]},
        "add_decisions": {"type": "array", "items": {"type": "string"}},
        "add_open_questions": {"type": "array", "items": {"type": "string"}},
        "add_risks": {"type": "array", "items": {"type": "string"}},
        "add_action_items": {"type": "array", "items": {"type": "string"}},
        "add_parking_lot": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
