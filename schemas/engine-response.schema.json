{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["should_suggest", "confidence", "category", "suggestion", "reason", "follow_up_question", "evidence_segment_ids", "summary_patch", "next_steps", "suggested_agenda", "translations", "signals", "state_patch"],
  "properties": {
    "should_suggest": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "category": {"enum": ["answer", "missing_decision", "unresolved_question", "contradiction", "risk", "alternative", "summary", "action_item", "off_topic", "no_material_value"]},
    "suggestion": {"type": "string", "maxLength": 1200},
    "reason": {"type": "string", "maxLength": 2000},
    "follow_up_question": {"type": ["string", "null"], "maxLength": 1000},
    "evidence_segment_ids": {"type": "array", "items": {"type": "string"}},
    "summary_patch": {
      "type": "object", "additionalProperties": false,
      "required": ["current_topic", "discussion_summary"],
      "properties": {
        "current_topic": {"type": ["string", "null"], "maxLength": 500},
        "discussion_summary": {"type": ["string", "null"], "maxLength": 5000}
      }
    },
    "next_steps": {"type": "array", "maxItems": 20, "items": {"type": "string"}},
    "suggested_agenda": {"type": "array", "maxItems": 20, "items": {"type": "string"}},
    "translations": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["segment_id", "language", "text"],
        "properties": {
          "segment_id": {"type": "string"},
          "language": {"enum": ["zh-TW", "zh-CN", "en", "ja", "ko"]},
          "text": {"type": "string", "minLength": 1, "maxLength": 20000}
        }
      }
    },
    "signals": {
      "type": "object", "additionalProperties": false,
      "required": ["question_detected", "discussion_stuck", "missing_risk_detected", "contradiction_detected", "decision_point_detected"],
      "properties": {
        "question_detected": {"type": "boolean"},
        "discussion_stuck": {"type": "boolean"},
        "missing_risk_detected": {"type": "boolean"},
        "contradiction_detected": {"type": "boolean"},
        "decision_point_detected": {"type": "boolean"}
      }
    },
    "state_patch": {
      "type": "object", "additionalProperties": false,
      "required": ["current_topic", "add_decisions", "add_open_questions", "add_risks", "add_action_items", "add_parking_lot", "add_project_memory"],
      "properties": {
        "current_topic": {"type": ["string", "null"]},
        "add_decisions": {"type": "array", "items": {"type": "string"}},
        "add_open_questions": {"type": "array", "items": {"type": "string"}},
        "add_risks": {"type": "array", "items": {"type": "string"}},
        "add_action_items": {"type": "array", "items": {"type": "string"}},
        "add_parking_lot": {"type": "array", "items": {"type": "string"}},
        "add_project_memory": {"type": "array", "maxItems": 20, "items": {"type": "string"}}
      }
    }
  }
}
